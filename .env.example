# Copy to .env.local for local development, and add the same values in your host's
# environment settings (e.g. Vercel > Project > Settings > Environment Variables).
# Rebuild after changing any of them: the homepage is generated at build time.

# --- Enquiry form (optional) ----------------------------------------------------
# Without RESEND_API_KEY and ENQUIRY_FROM_EMAIL the form is not shown at all and
# visitors use the Instagram and email buttons (which always work).
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g.
# ENQUIRY_FROM_EMAIL="The Lumen Desk <website@thelumendesk.com>"
ENQUIRY_FROM_EMAIL=
# Where enquiries are delivered. Defaults to harsh@thelumendesk.com.
ENQUIRY_TO_EMAIL=

# --- Publishing rules (optional) ------------------------------------------------
# "true" = only show projects marked rightsCleared: true in src/data/projects.ts.
NEXT_PUBLIC_REQUIRE_RIGHTS_CLEARANCE=
